<UserControl x:Class="WordTrail.Desktop.Views.ReviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:WordTrail.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="一步一步，記得更牢" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="重新檢查" Command="{Binding RefreshCommand}" /><Button Content="撤銷上次" Command="{Binding UndoCommand}" AutomationProperties.AutomationId="UndoReview" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="200" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="複習範圍" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" IsEnabled="{Binding CanChangeCategory}" AutomationProperties.Name="複習主題" AutomationProperties.AutomationId="ReviewCategory" />
                <Button Grid.Column="2" Content="套用" Command="{Binding ApplyCategoryCommand}" Margin="10,0,0,0" AutomationProperties.AutomationId="ApplyReviewCategory" />
                <TextBlock Grid.Column="3" Text="{Binding ScopeText}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>
        <views:StatusBanner Grid.Row="2" />
        <Border Grid.Row="3" Style="{StaticResource Panel}" Padding="18,14" Visibility="{Binding HasCard, Converter={StaticResource BoolVisibility}}">
            <Grid x:Name="ContentHost">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <StackPanel Width="{Binding ActualWidth, ElementName=ContentHost}">
                        <TextBlock Text="{Binding Current.Word.Headword}" FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.AutomationId="ReviewHeadword" />
                        <TextBlock Text="{Binding Current.Word.PartOfSpeech}" Foreground="{StaticResource AccentBrush}" FontSize="13" TextAlignment="Center" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Current.Word.Cue}" Style="{StaticResource MutedText}" FontSize="12" TextAlignment="Center" Margin="0,3,0,0" />
                        <WrapPanel HorizontalAlignment="Center" Margin="0,7,0,5">
                            <Button Content="{Binding SpeakButtonText}" Command="{Binding SpeakCommand}" Padding="10,6" Margin="0,0,8,0" AutomationProperties.AutomationId="SpeakWord" />
                            <Button Content="{Binding SpeakExampleButtonText}" Command="{Binding SpeakExampleCommand}" Padding="10,6" Margin="0,0,8,0" AutomationProperties.AutomationId="SpeakExamples" />
                            <Button Content="外部辭典 ↗" Command="{Binding DictionaryCommand}" Padding="10,6" Margin="0" />
                        </WrapPanel>
                        <TextBlock Text="先想想這個詞義，再翻卡確認。" Style="{StaticResource MutedText}" FontSize="15" TextAlignment="Center" Margin="0,16,0,0" Visibility="{Binding IsQuestionVisible, Converter={StaticResource BoolVisibility}}" />
                        <StackPanel Visibility="{Binding IsAnswerVisible, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="{Binding Current.Word.Meaning}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,8" AutomationProperties.AutomationId="ReviewMeaning" />
                            <TextBlock Text="常用搭配" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding CollocationsText}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,7" />
                            <StackPanel Visibility="{Binding HasSynonyms, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,7">
                                <TextBlock Text="同義詞" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding SynonymsText}" FontSize="14" TextWrapping="Wrap" AutomationProperties.AutomationId="ReviewSynonyms" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Examples}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F5F7FB" CornerRadius="9" Padding="10,7" Margin="0,0,0,6">
                                            <StackPanel><TextBlock Text="{Binding English}" FontSize="15" TextWrapping="Wrap" /><TextBlock Text="{Binding Chinese}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,0" /></StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Visibility="{Binding HasNotes, Converter={StaticResource BoolVisibility}}" Margin="0,3,0,0">
                                <TextBlock Text="我的筆記" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding Current.Word.Notes}" FontSize="13" TextWrapping="Wrap" AutomationProperties.AutomationId="ReviewNotes" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Viewbox>
            </Grid>
        </Border>
        <Border Grid.Row="3" Padding="24" Background="White" CornerRadius="14">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasCard}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <TextBlock Text="{Binding EmptyText}" Style="{StaticResource MutedText}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="550" />
        </Border>
        <StackPanel Grid.Row="4" Margin="0,10,0,0" Visibility="{Binding HasCard, Converter={StaticResource BoolVisibility}}">
            <Button Content="{Binding FlipButtonText}" Command="{Binding FlipCommand}" Style="{StaticResource PrimaryButton}" Margin="0" Padding="14,12" Visibility="{Binding IsQuestionVisible, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="FlipCard" />
            <UniformGrid Columns="4" Visibility="{Binding IsAnswerVisible, Converter={StaticResource BoolVisibility}}">
                <Button Content="{Binding AgainButtonText}" Command="{Binding AgainCommand}" Margin="0,0,8,0" Padding="8,12" AutomationProperties.AutomationId="RateAgain" />
                <Button Content="{Binding HardButtonText}" Command="{Binding HardCommand}" Margin="0,0,8,0" Padding="8,12" AutomationProperties.AutomationId="RateHard" />
                <Button Content="{Binding GoodButtonText}" Command="{Binding GoodCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="8,12" AutomationProperties.AutomationId="RateGood" />
                <Button Content="{Binding EasyButtonText}" Command="{Binding EasyCommand}" Margin="0" Padding="8,12" AutomationProperties.AutomationId="RateEasy" />
            </UniformGrid>
            <TextBlock Text="{Binding KeyboardHint}" Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Center" Margin="0,7,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
