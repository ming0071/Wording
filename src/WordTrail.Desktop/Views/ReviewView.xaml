<UserControl x:Class="WordTrail.Desktop.Views.ReviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:WordTrail.Desktop.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="重新取卡" Command="{Binding RefreshCommand}" ToolTip="重新讀取目前排程；上次保存不確定時可用此確認狀態" />
                <Button DockPanel.Dock="Right" Content="撤銷上次評分" Command="{Binding UndoCommand}" AutomationProperties.AutomationId="UndoReview" />
                <TextBlock Text="回想一下" Style="{StaticResource PageTitle}" />
            </DockPanel>
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" Margin="0,0,0,18" />
            <views:StatusBanner />
            <Border Style="{StaticResource Panel}" Padding="32" Visibility="{Binding HasCard, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <TextBlock Text="ENGLISH → 意思" Foreground="#8893A5" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,24" />
                    <TextBlock Text="{Binding Current.Word.Headword}" FontSize="42" FontWeight="SemiBold" AutomationProperties.AutomationId="ReviewHeadword" />
                    <TextBlock Text="{Binding Current.Word.PartOfSpeech}" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,8" FontSize="16" />
                    <TextBlock Text="{Binding Current.Word.Cue}" Style="{StaticResource MutedText}" FontStyle="Italic" Margin="0,0,0,18" />
                    <WrapPanel>
                        <Button Content="播放發音" Command="{Binding SpeakCommand}" AutomationProperties.AutomationId="SpeakWord" />
                        <Button Content="停止" Command="{Binding StopSpeechCommand}" />
                        <Button Content="查 Oxford ↗" Command="{Binding DictionaryCommand}" ToolTip="開啟外部辭典；卡片內容不因此成為辭典提供" />
                    </WrapPanel>
                    <Button Content="顯示答案 · Space" Style="{StaticResource PrimaryButton}" Command="{Binding FlipCommand}" HorizontalAlignment="Left" Margin="0,20,0,8" AutomationProperties.AutomationId="FlipCard" />
                    <StackPanel Visibility="{Binding IsAnswerVisible, Converter={StaticResource BoolVisibility}}" Margin="0,14,0,0">
                        <Border Height="1" Background="#E7EBF2" Margin="0,0,0,22" />
                        <TextBlock Text="{Binding Current.Word.Meaning}" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,16" AutomationProperties.AutomationId="ReviewMeaning" />
                        <TextBlock Text="{Binding MeaningOriginText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Current.Word.Collocations}" Margin="0,0,0,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#5A6284" Margin="0,3" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding CollocationsOriginText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,12" />
                        <Button Content="播放第一個例句" Command="{Binding SpeakExampleCommand}" HorizontalAlignment="Left" />
                        <ItemsControl ItemsSource="{Binding Examples}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F7F8FC" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding English}" FontSize="16" TextWrapping="Wrap" LineHeight="25" />
                                            <TextBlock Text="{Binding Chinese}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Source}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,9,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="你剛才記得多少？" FontWeight="SemiBold" Margin="0,12,0,12" />
                        <UniformGrid Columns="4">
                            <Button Content="1  忘記" Command="{Binding AgainCommand}" AutomationProperties.AutomationId="RateAgain" />
                            <Button Content="2  困難" Command="{Binding HardCommand}" AutomationProperties.AutomationId="RateHard" />
                            <Button Content="3  記得" Command="{Binding GoodCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="RateGood" />
                            <Button Content="4  簡單" Command="{Binding EasyCommand}" AutomationProperties.AutomationId="RateEasy" />
                        </UniformGrid>
                        <TextBlock Text="{Binding OriginText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,14,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Padding="32">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCard}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="先告一段落" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource MutedText}" />
                    <Button Content="重新檢查到期卡" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,22,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Text="Windows 合成語音 · 翻面與播放不會更新複習時間。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,16,0,5" />
            <TextBlock Text="{Binding SpeechStatus}" Style="{StaticResource MutedText}" FontSize="11" />
        </StackPanel>
    </ScrollViewer>
</UserControl>