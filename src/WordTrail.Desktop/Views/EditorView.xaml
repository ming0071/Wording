<UserControl x:Class="WordTrail.Desktop.Views.EditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:WordTrail.Desktop.Views">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <Button Content="← 返回單字庫" Command="{Binding BackCommand}" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="BackToLibrary" Margin="0,0,0,14" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="保存詞義" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveWord" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            </DockPanel>
            <TextBlock Text="同一個單字可以有多個詞義，按「新增另一個詞義」即可一起保存。每個意思各自複習，修改內容保留原有進度。" Style="{StaticResource MutedText}" Margin="0,0,0,18" />
            <views:StatusBanner />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel}" Padding="22" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="詞義與例句" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="單字／固定片語 *" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Headword, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="單字或固定片語" AutomationProperties.AutomationId="HeadwordInput" />
                        <TextBlock Text="詞性 *" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding PartOfSpeechOptions}" SelectedItem="{Binding PartOfSpeech}" AutomationProperties.Name="詞性" AutomationProperties.AutomationId="PartOfSpeechInput" />
                        <TextBlock Text="這個詞義的繁中解釋 *" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Meaning, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="78" MaxLength="1500" AutomationProperties.Name="繁中詞義" AutomationProperties.AutomationId="MeaningInput" />
                        <TextBlock Text="英文情境提示（同詞多義時使用）" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Cue, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MaxLength="300" AutomationProperties.Name="英文情境提示" />
                        <TextBlock Text="分類（以頓號或逗號分隔）" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding CategoriesText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AutomationProperties.Name="分類" AutomationProperties.AutomationId="CategoriesInput" />
                        <TextBlock Text="{Binding CategoryHint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />
                        <TextBlock Text="建議優先級" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" AutomationProperties.Name="建議優先級" />
                        <TextBlock Text="常見搭配（每行一個）" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding CollocationsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" AutomationProperties.Name="常見搭配" />
                        <TextBlock Text="同義詞（以頓號、逗號或換行分隔）" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SynonymsText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AutomationProperties.Name="同義詞" AutomationProperties.AutomationId="SynonymsInput" />
                        <TextBlock Text="我的筆記（記憶提示、容易混淆的地方）" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxLength="4000" AutomationProperties.Name="我的筆記" AutomationProperties.AutomationId="NotesInput" />
                        <TextBlock Text="雙語例句" Style="{StaticResource FieldLabel}" />
                        <ItemsControl ItemsSource="{Binding Examples}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F7F8FC" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="英文" FontSize="12" Margin="0,0,0,5" />
                                            <TextBox Text="{Binding English, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="英文例句" />
                                            <TextBlock Text="繁中" FontSize="12" Margin="0,10,0,5" />
                                            <TextBox Text="{Binding Chinese, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" AutomationProperties.Name="例句繁中翻譯" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="＋ 再加一個例句" Command="{Binding AddExampleCommand}" HorizontalAlignment="Left" />
                        <ItemsControl ItemsSource="{Binding AdditionalSenses}" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDE3F1" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="移除詞義" Padding="8,5" Command="{Binding DataContext.RemoveSenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                <TextBlock Text="另一個詞義" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="詞性 *" Style="{StaticResource FieldLabel}" />
                                            <ComboBox ItemsSource="{Binding DataContext.PartOfSpeechOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding PartOfSpeech}" AutomationProperties.Name="另一詞義的詞性" />
                                            <TextBlock Text="繁中解釋 *" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Meaning, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="68" MaxLength="1500" AutomationProperties.Name="另一詞義的繁中解釋" />
                                            <TextBlock Text="英文情境提示" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Cue, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MaxLength="300" />
                                            <Expander Header="同義詞、筆記與例句（選填）" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="同義詞" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding SynonymsText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                                    <TextBlock Text="我的筆記" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" MaxLength="4000" />
                                                    <TextBlock Text="英文例句" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding English, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" />
                                                    <TextBlock Text="繁中翻譯" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Chinese, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" />
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="＋ 新增另一個詞義" Command="{Binding AddSenseCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="AddSense" />
                        <CheckBox Content="暫停複習（保留進度）" IsChecked="{Binding IsPaused}" Margin="0,14,0,10" />
                        <CheckBox Content="封存這個詞義（保留進度）" IsChecked="{Binding IsArchived}" Margin="0,0,0,14" />
                        <TextBlock Text="{Binding OriginText}" Style="{StaticResource MutedText}" FontSize="11" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Panel}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="補充學習內容" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="輸入詞條即可建議一個常見意思；已有指定詞義時會依該意思補充搭配及兩個雙語例句。保存前請確認詞性與詞義。" Style="{StaticResource MutedText}" />
                            <CheckBox IsChecked="{Binding AiConsent}" Margin="0,16,0,14">
                                <TextBlock Text="同意將這個詞義與必要內容交給本機 Codex，使用我的訂閱額度。" TextWrapping="Wrap" FontSize="12" />
                            </CheckBox>
                            <Button Content="用 Codex 產生預覽" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="GenerateContent" />
                            <Button Content="取消生成" Command="{Binding CancelGenerationCommand}" Visibility="{Binding GenerateCommand.IsRunning, Converter={StaticResource BoolVisibility}}" />
                            <TextBlock Text="需要已登入的官方 Codex CLI；在設定可檢查可用性。沒有登入仍可手動編輯與複習。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Padding="20" Margin="0,16,0,0" Visibility="{Binding HasPreview, Converter={StaticResource BoolVisibility}}">
                        <StackPanel>
                            <TextBlock Text="AI 預覽 · 尚未保存" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding Preview.Meaning}" FontWeight="SemiBold" Margin="0,0,0,14" />
                            <ItemsControl ItemsSource="{Binding Preview.Collocations}" Margin="0,0,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Preview.Examples}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding English}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Chinese}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="套用到編輯欄位" Command="{Binding ApplyPreviewCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="ApplyAiPreview" />
                            <Button Content="捨棄預覽" Command="{Binding DiscardPreviewCommand}" />
                            <TextBlock Text="AI 可能有誤，請核對指定詞義與例句。套用會替換目前的解釋、搭配與例句，再按保存才會寫入單字庫。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#EDF0FA" CornerRadius="12" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="到可信辭典查閱" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Button Content="Oxford Learner's ↗" Command="{Binding DictionaryCommand}" />
                            <TextBlock Text="這是外部查閱連結；本卡自編或 AI 內容不代表由 Oxford 提供。" Style="{StaticResource MutedText}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
