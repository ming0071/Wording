<UserControl x:Class="WordTrail.Desktop.Views.EditorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:WordTrail.Desktop.Views">
    <UserControl.Resources>
        <Style x:Key="PosChip" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Foreground" Value="#536071" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Chip" Background="#F0F2F6" CornerRadius="16" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chip" Property="Background" Value="#E9E6FF" /><Setter Property="Foreground" Value="#5546C7" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="#E3E5EF" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#7568D9" /><Setter TargetName="Chip" Property="BorderThickness" Value="1" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="SenseFields">
            <StackPanel>
                <ListBox ItemsSource="{Binding PartOfSpeechChoices}" SelectedValuePath="Value" SelectedValue="{Binding PartOfSpeech, Mode=TwoWay}" DisplayMemberPath="Label" ItemContainerStyle="{StaticResource PosChip}"
                         Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="PartOfSpeechInput" AutomationProperties.Name="詞性">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
                <TextBlock Text="中文解釋 *" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                <TextBox Text="{Binding Meaning, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" MaxLength="1500" AutomationProperties.Name="中文解釋" />
                <TextBlock Text="英文解釋" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                <TextBox Text="{Binding EnglishDefinition, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" MaxLength="4000" AutomationProperties.Name="英文解釋" />
                <DockPanel Margin="0,14,0,4">
                    <Button Content="＋ 新增例句" Command="{Binding AddExampleCommand}" DockPanel.Dock="Right" Padding="8,4" Margin="0" FontSize="12" />
                    <TextBlock Text="例句 · 英文／中文翻譯" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Examples}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBox Text="{Binding English, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="4000" AutomationProperties.Name="英文例句" />
                                <TextBox Text="{Binding Chinese, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="4000" Margin="0,6,0,0" AutomationProperties.Name="例句中文翻譯" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="×" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="移除例句"
                                    Command="{Binding DataContext.RemoveExampleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="同義詞" Style="{StaticResource FieldLabel}" Margin="0,8,0,5" />
                <TextBox Text="{Binding SynonymsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="同義詞，以逗號分隔" />
                <TextBlock Text="以逗號或頓號分隔多個同義詞" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
                <TextBlock Text="筆記" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxLength="4000" AutomationProperties.Name="筆記" />
                <Expander Header="搭配詞與情境提示" Margin="0,16,0,0" Foreground="#536071">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="常用搭配（每行一個）" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding CollocationsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" AutomationProperties.Name="常用搭配" />
                        <TextBlock Text="卡片正面的情境提示" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Cue, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MaxLength="1000" AutomationProperties.Name="情境提示" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,14">
                <Button Content="← 返回單字庫" Command="{Binding BackCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="BackToLibrary" Margin="0,0,20,0" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0" />
            </DockPanel>
            <views:StatusBanner />
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" MinWidth="100" AutomationProperties.AutomationId="SaveWord" />
                <Button Content="保存，建立下一張" Command="{Binding SaveNextCommand}" Margin="4,0,0,0" AutomationProperties.AutomationId="SaveNextWord" />
            </StackPanel>
            <TextBlock Text="每組解釋各自複習" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="320" /><ColumnDefinition Width="12" /><ColumnDefinition Width="2*" MinWidth="280" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="DefinitionScroll">
                    <StackPanel Margin="20">
                        <TextBlock Text="單字／片語" Style="{StaticResource FieldLabel}" Margin="0,0,0,7" />
                        <TextBox Text="{Binding Headword, UpdateSourceTrigger=PropertyChanged}" FontSize="22" Padding="12" MaxLength="100" AutomationProperties.AutomationId="HeadwordInput" AutomationProperties.Name="單字或固定片語" />
                        <TextBlock Text="解釋 1" FontWeight="SemiBold" Foreground="#8B91A0" FontSize="12" Margin="0,22,0,10" />
                        <ContentControl Content="{Binding PrimarySense}" ContentTemplate="{StaticResource SenseFields}" />
                        <ItemsControl ItemsSource="{Binding AdditionalSenses}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <StackPanel>
                                    <Border Height="1" Background="#E3E8F0" Margin="0,14,0,18" />
                                    <DockPanel Margin="0,0,0,10">
                                        <Button Content="移除解釋" DockPanel.Dock="Right" Padding="8,4" FontSize="12" Margin="0" Command="{Binding DataContext.RemoveSenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding SenseLabel}" FontWeight="SemiBold" Foreground="#8B91A0" FontSize="12" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SenseFields}" />
                                </StackPanel>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="＋ 新增另一組解釋" Command="{Binding AddSenseCommand}" HorizontalAlignment="Left" Foreground="#5546C7" Margin="0,22,0,0" AutomationProperties.AutomationId="AddDefinition" />
                        <Border Height="1" Background="#E3E8F0" Margin="0,22,0,6" />
                        <TextBlock Text="主題分類" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="加入" Command="{Binding AddCategorySelectionCommand}" Margin="8,0,0,0" />
                            <ComboBox ItemsSource="{Binding AvailableCategories}" IsEditable="True" Text="{Binding CategoryDraft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="主題分類" AutomationProperties.AutomationId="EditorCategory" />
                        </DockPanel>
                        <TextBlock Text="可從選單挑選，或輸入新的主題名稱後加入。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" />
                        <ItemsControl ItemsSource="{Binding SelectedCategories}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding StringFormat={}{0} ×}" Padding="10,5" Foreground="#5546C7" Command="{Binding DataContext.RemoveCategorySelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Expander Header="學習選項" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="程度" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" />
                                <CheckBox Content="暫停複習" IsChecked="{Binding IsPaused}" Margin="0,12,0,0" />
                                <CheckBox Content="封存" IsChecked="{Binding IsArchived}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#DFE3EE" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True" AutomationProperties.Name="調整編輯與字典比例" />
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="查詢與填入" Style="{StaticResource SectionTitle}" />
                    <TabControl SelectedIndex="{Binding HelperTabIndex}" BorderThickness="0" Background="Transparent" Margin="0,10,0,0">
                        <TabItem Header="線上字典" Padding="16,8">
                            <DockPanel Margin="0,12,0,0">
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="搜尋字典" Command="{Binding DictionaryCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="SearchDictionary" />
                                    <ComboBox ItemsSource="{Binding Dictionaries}" SelectedItem="{Binding SelectedDictionary}" AutomationProperties.Name="選擇字典" />
                                </DockPanel>
                                <views:DictionaryBrowser SourceUri="{Binding DictionaryUri}" AutomationProperties.AutomationId="EmbeddedDictionary" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Codex 填入" Padding="16,8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,14,0,0">
                        <TextBlock Text="用 Codex 補齊內容" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="選擇要填入的解釋；若已填中文，會依照這個意思生成。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,12" />
                        <ComboBox ItemsSource="{Binding AiTargets}" SelectedItem="{Binding AiTarget}" DisplayMemberPath="SenseLabel" AutomationProperties.Name="Codex 填入目標" />
                        <CheckBox IsChecked="{Binding AiConsent}" Margin="0,14,0,14"><TextBlock Text="將這個單字與指定詞義傳送給 Codex" TextWrapping="Wrap" FontSize="12" /></CheckBox>
                        <Button Content="生成內容" Command="{Binding GenerateCommand}" Style="{StaticResource PrimaryButton}" Margin="0" AutomationProperties.AutomationId="GenerateContent" />
                        <Button Content="取消生成" Command="{Binding CancelGenerationCommand}" Margin="0,8,0,0" Visibility="{Binding GenerateCommand.IsRunning, Converter={StaticResource BoolVisibility}}" />
                        <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource BoolVisibility}}" Margin="0,20,0,0" AutomationProperties.AutomationId="CodexPreview">
                            <TextBlock Text="預覽" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding Preview.Meaning}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Preview.EnglishDefinition}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <ItemsControl ItemsSource="{Binding Preview.Synonyms}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#5546C7" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <ItemsControl ItemsSource="{Binding Preview.Collocations}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <ItemsControl ItemsSource="{Binding Preview.Examples}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding English}" TextWrapping="Wrap" /><TextBlock Text="{Binding Chinese}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <Button Content="套用到選定的解釋" Command="{Binding ApplyPreviewCommand}" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" />
                            <Button Content="捨棄預覽" Command="{Binding DiscardPreviewCommand}" Margin="0,8,0,0" />
                        </StackPanel>
                            </StackPanel></ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
