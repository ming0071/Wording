<UserControl x:Class="WordTrail.Desktop.Views.DictionaryBrowser" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="Status" Text="輸入單字後按「搜尋字典」，結果會顯示在這裡。" TextWrapping="Wrap" Foreground="#68758A" FontSize="12" />
            <Button Content="在瀏覽器開啟 ↗" Click="OpenExternal" HorizontalAlignment="Right" Padding="8,4" Margin="0,5,0,0" FontSize="11" />
        </StackPanel>
        <Grid x:Name="BrowserHost" Background="#F7F8FC" MinHeight="180" />
    </DockPanel>
</UserControl>
