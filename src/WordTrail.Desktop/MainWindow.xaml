<Window x:Class="WordTrail.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WordTrail · 每天走近英文" Icon="Assets/WordTrail.ico" Width="1240" Height="850" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F5F7FB" Foreground="{StaticResource InkBrush}" FontFamily="Segoe UI, Microsoft JhengHei UI" FontSize="14" PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing" AutomationProperties.AutomationId="MainWindow">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="205" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="#E3E8F0" BorderThickness="0,0,1,0" Padding="18,28">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="10,0,0,30">
                    <Image Source="Assets/WordTrail.png" Width="42" Height="42" HorizontalAlignment="Left" Margin="0,0,0,14" />
                    <TextBlock Text="WordTrail" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="一個詞義，一點進步" Style="{StaticResource MutedText}" Margin="0,6,0,0" FontSize="12" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="10,20,0,0">
                    <TextBlock Text="本機保存 · 屬於你的單字庫" FontSize="11" Style="{StaticResource MutedText}" />
                    <TextBlock Text="0.1.4" FontSize="11" Foreground="#9AA5B5" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel>
                    <Button Content="今日學習" Tag="{Binding IsTodaySelected}" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="today" AutomationProperties.AutomationId="NavToday" />
                    <Button Content="單字庫" Tag="{Binding IsLibrarySelected}" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="library" AutomationProperties.AutomationId="NavLibrary" />
                    <Button Content="開始複習" Tag="{Binding IsReviewSelected}" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="review" AutomationProperties.AutomationId="NavReview" />
                    <Button Content="設定與備份" Tag="{Binding IsSettingsSelected}" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="settings" AutomationProperties.AutomationId="NavSettings" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="30,22,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding CurrentSection}" Foreground="#7B879B" FontSize="12" Margin="0,0,0,18" />
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
