<UserControl x:Class="Wording.Desktop.Views.CategoryChips" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Wording.Desktop.Views">
    <UserControl.Resources>
    <DataTemplate x:Key="ChipOptions">
        <ItemsControl ItemsSource="{Binding Choices}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
                <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding ToggleCommand}" Margin="0,0,7,6" Padding="14,7" AutomationProperties.Name="{Binding Name}">
                    <ToggleButton.Style><Style TargetType="ToggleButton">
                        <Setter Property="Foreground" Value="#58657A" /><Setter Property="Background" Value="#F0F2F6" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#E9E6FF" /><Setter Property="Foreground" Value="#5546C7" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#7568D9" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#BFB7EC" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6" /></Trigger>
                        </Style.Triggers>
                    </Style></ToggleButton.Style>
                </ToggleButton>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>
    <DataTemplate x:Key="ScrollableChipOptions">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="94" Focusable="False">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ChipOptions}" HorizontalContentAlignment="Stretch" />
        </ScrollViewer>
    </DataTemplate>
    </UserControl.Resources>
        <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch">
            <ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource ScrollableChipOptions}" /><Style.Triggers>
                <DataTrigger Binding="{Binding ShowAllChoices, RelativeSource={RelativeSource AncestorType=views:CategoryChips}}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource ChipOptions}" /></DataTrigger>
            </Style.Triggers></Style></ContentControl.Style>
        </ContentControl>
</UserControl>
