<UserControl x:Class="Wording.Desktop.Views.ReadingPracticePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Visibility="{Binding CanRead, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0">
  <Button Content="練習此句" Command="{Binding Reading.SelectCommand}" CommandParameter="{Binding}" HorizontalAlignment="Right" Padding="10,5" FontSize="12"
   Visibility="{Binding IsNotSelected, Converter={StaticResource BoolVisibility}}" />
  <Border BorderBrush="#DCDDF8" BorderThickness="0,1,0,0" Padding="0,9,0,0" Visibility="{Binding IsSelected, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="InlineReadingPractice">
   <StackPanel>
    <WrapPanel VerticalAlignment="Center">
     <TextBlock Text="例句錄音辨識 · Codex" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
     <Border Background="{Binding Reading.StateBackground}" CornerRadius="5" Padding="7,3">
      <TextBlock Text="{Binding Reading.StateLabel}" Foreground="{Binding Reading.StateColor}" FontSize="12" FontWeight="SemiBold" AutomationProperties.AutomationId="ReadingState" AutomationProperties.LiveSetting="Polite" />
     </Border>
    </WrapPanel>
    <WrapPanel Margin="0,5,0,0">
     <Button Content="朗讀此句" Command="{Binding Reading.PronounceCommand}" CommandParameter="{Binding English}" FontSize="12" Padding="9,6" Margin="0,0,6,5" AutomationProperties.AutomationId="PronounceExample" />
     <Button Content="{Binding Reading.NextLabel}" Command="{Binding Reading.NextCommand}" FontSize="12" Padding="9,6" Margin="0,0,6,5" AutomationProperties.AutomationId="NextReadingExample" />
    </WrapPanel>
    <WrapPanel Margin="0,5,0,0">
     <Button Content="{Binding Reading.RecordLabel}" Command="{Binding Reading.RecordCommand}" Style="{StaticResource PrimaryButton}" FontSize="12" Padding="9,6" Margin="0,0,6,5" AutomationProperties.AutomationId="RecordReading" />
     <Button Content="{Binding Reading.ReplayLabel}" Command="{Binding Reading.ReplayCommand}" FontSize="12" Padding="9,6" Margin="0,0,6,5" />
     <Button Content="取消 · Esc" Command="{Binding Reading.CancelCommand}" FontSize="12" Padding="9,6" Margin="0,0,0,5" />
    </WrapPanel>
    <TextBlock Text="{Binding Reading.Status}" Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="ReadingStatus" />
    <WrapPanel Margin="0,7,0,0" Visibility="{Binding Reading.HasError, Converter={StaticResource BoolVisibility}}">
     <Button Content="前往設定" Command="{Binding Reading.OpenSettingsCommand}" FontSize="12" Padding="9,6" Margin="0,0,8,4" AutomationProperties.AutomationId="ReadingOpenSettings" />
     <TextBlock Text="檢查 Codex 路徑與登入後，再回來重新連線。" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,4" />
    </WrapPanel>
    <TextBlock Text="下一句會循環回到第一句 · Ctrl+↑／↓ 也可切換 · 錄音傳至 OpenAI 辨識" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasTranscript, Converter={StaticResource BoolVisibility}}">
     <TextBlock Text="辨識出的英文" Style="{StaticResource MutedText}" FontSize="12" />
     <TextBlock Text="{Binding Transcript}" FontSize="19" TextWrapping="Wrap" Margin="0,3,0,6" AutomationProperties.AutomationId="ReadingTranscript" />
    </StackPanel>
    <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolVisibility}}" Margin="0,6,0,0">
     <TextBlock Text="{Binding Verdict}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
     <TextBlock Text="{Binding Counts}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,6" />
     <ItemsControl ItemsSource="{Binding Words}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="4" Padding="6,4" Margin="0,0,5,5"><TextBlock Text="{Binding Text}" Foreground="{Binding Color}" FontSize="14" /></Border></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="只比對辨識文字，不評發音分數、不影響熟悉度。" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
