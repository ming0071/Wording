<UserControl x:Class="Wording.Desktop.Views.StatusBanner" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10" AutomationProperties.Name="正在處理" />
        <Border Background="#FFF1F0" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Error}" Foreground="#A12F32" TextWrapping="Wrap" AutomationProperties.AutomationId="ErrorMessage" AutomationProperties.LiveSetting="Assertive" />
        </Border>
        <Border CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#EEF4FF" />
                    <Setter Property="Padding" Value="12" />
                    <Setter Property="Margin" Value="0,0,0,12" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2,0,6" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Notice}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Notice}" Foreground="#354A7B" TextWrapping="Wrap" AutomationProperties.AutomationId="StatusMessage" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers><DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True"><Setter Property="FontSize" Value="12" /></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
        </Border>
    </StackPanel>
</UserControl>
