<UserControl x:Class="Wording.Desktop.Views.TranslationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Wording.Desktop.Views">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="把想法，寫成英文" Style="{StaticResource PageTitle}" />
            <TextBlock Text="從較不熟悉的單字開始，練習自己組出一句話。" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="題數" VerticalAlignment="Center" Margin="0,0,10,8" />
                <ComboBox ItemsSource="{Binding QuestionCounts}" SelectedItem="{Binding QuestionCount}" Width="70" Margin="0,0,12,8" AutomationProperties.AutomationId="TranslationQuestionCount">
                    <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                    </Style.Triggers></Style></ComboBox.Style>
                </ComboBox>
                <Button Content="出一組新題目" Command="{Binding GenerateCommand}" AutomationProperties.AutomationId="GenerateTranslation" />
                <Button Content="取消" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
            </WrapPanel>
            <TextBlock Text="只選較不熟悉的詞彙；作答不影響單字熟悉度與複習排程。" Style="{StaticResource MutedText}" FontSize="12" />
            <views:StatusBanner />
        </StackPanel>
        <ScrollViewer x:Name="ExerciseScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="中翻英題目與批改">
            <StackPanel Margin="0,0,12,8">
                <Border Style="{StaticResource Panel}" Margin="0,8,0,0" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolVisibility}}">
                    <StackPanel>
                        <TextBlock Text="從看得懂，到說得出自己的意思" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="按「出一組新題目」，再用每題指定的單字翻譯中文句子。填完後提交，看看意思、用法和文法有哪些地方可以調整。" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="QuestionList" ItemsSource="{Binding Questions}" AutomationProperties.AutomationId="TranslationQuestions">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Panel}" Padding="20" Margin="0,8,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Number}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock Text="{Binding Chinese}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
                                <WrapPanel>
                                    <TextBlock Text="請使用" Style="{StaticResource MutedText}" Margin="0,0,8,4" />
                                    <TextBlock Text="{Binding Target}" FontWeight="SemiBold" Margin="0,0,12,4" />
                                    <TextBlock Text="{Binding TargetMeaning}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                                </WrapPanel>
                                <TextBlock Text="你的英文句子" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" MaxHeight="160" MaxLength="2000"
                                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="16"
                                    IsReadOnly="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AutomationProperties.AutomationId="TranslationAnswer" AutomationProperties.Name="{Binding Number}"
                                    SpellCheck.IsEnabled="True" Language="en-US" />
                                <Border x:Name="FeedbackPanel" Background="#F5F7FB" CornerRadius="10" Padding="16" Margin="0,16,0,0" Visibility="{Binding HasFeedback, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="TranslationFeedback">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding VerdictText}" Foreground="{Binding VerdictColor}" FontWeight="SemiBold" FontSize="17" Margin="12,0,0,0" AutomationProperties.AutomationId="TranslationVerdict" AutomationProperties.LiveSetting="Polite" />
                                            <TextBlock Text="{Binding Number, StringFormat={}{0} · 批改結果}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,20,0">
                                                <TextBlock Text="你的答案" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                <TextBlock Text="{Binding Answer}" FontSize="16" AutomationProperties.AutomationId="TranslationSubmittedAnswer" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="建議寫法" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                <TextBlock Text="{Binding SuggestedEnglish}" FontSize="16" AutomationProperties.AutomationId="TranslationSuggestion" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="意思表達" FontWeight="SemiBold" /><TextBlock Text="{Binding MeaningFeedback}" Margin="0,4,0,10" />
                                        <TextBlock Text="指定單字" FontWeight="SemiBold" /><TextBlock Text="{Binding TargetFeedback}" Margin="0,4,0,10" />
                                        <TextBlock Text="文法與自然度" FontWeight="SemiBold" /><TextBlock Text="{Binding GrammarFeedback}" Margin="0,4,0,10" />
                                        <Expander Header="另一個參考譯句"><TextBlock Text="{Binding ReferenceEnglish}" Margin="0,8,0,0" /></Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="{Binding SubmitText}" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}"
                    Visibility="{Binding HasMaterial, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="SubmitTranslation" Margin="12,0,0,6" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="出題、批改各使用一次 AI 次數。當次題目與答案保留至關閉程式。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
