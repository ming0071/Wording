<UserControl x:Class="Wording.Desktop.Views.UpdatePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Wording.Desktop.Views">
    <Border Style="{StaticResource Panel}" Margin="0,0,0,18" AutomationProperties.AutomationId="UpdateSettings">
        <StackPanel>
            <TextBlock Text="版本與更新" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding CurrentVersion, StringFormat=目前版本：{0}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
            <TextBlock Text="下載完成後會關閉並重新開啟 Wording，詞庫與學習紀錄會沿用。隨時可選擇稍後更新。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" />
            <WrapPanel Margin="0,10,0,0">
                <Button Content="檢查更新" Command="{Binding CheckCommand}" AutomationProperties.AutomationId="CheckForUpdates" />
                <Button Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisibility}}" />
                <Button Content="查看更新內容 ↗" Command="{Binding ViewReleaseCommand}" Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisibility}}" />
                <Button Content="略過此版本" Command="{Binding SkipCommand}" Visibility="{Binding HasUpdate, Converter={StaticResource BoolVisibility}}" />
                <Button Content="取消下載" Command="{Binding CancelCommand}" Visibility="{Binding IsDownloading, Converter={StaticResource BoolVisibility}}" />
            </WrapPanel>
            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="5" Margin="0,6,0,10" Visibility="{Binding IsDownloading, Converter={StaticResource BoolVisibility}}" />
            <views:StatusBanner />
            <TextBlock Text="{Binding ReleaseNotes}" Style="{StaticResource MutedText}" FontSize="12" />
        </StackPanel>
    </Border>
</UserControl>
