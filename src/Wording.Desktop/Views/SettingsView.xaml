<UserControl x:Class="Wording.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Wording.Desktop.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="保存設定" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="SaveSettings" />
                <TextBlock Text="配合自己的步調" Style="{StaticResource PageTitle}" />
            </DockPanel>
            <TextBlock Text="調整每日學習量，照顧好你的單字與進度。" Style="{StaticResource MutedText}" Margin="0,0,0,22" />
            <views:StatusBanner />
            <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="每日學習" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="複習頁每日新詞上限" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DailyNewLimit, UpdateSourceTrigger=PropertyChanged}" MinWidth="180" HorizontalAlignment="Left" AutomationProperties.Name="每日新詞上限" AutomationProperties.AutomationId="DailyNewLimit" />
                    <TextBlock Text="{Binding DailyNewLimitHelp}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="複習快捷鍵" Style="{StaticResource SectionTitle}" />
                    <CheckBox Content="每張複習卡開啟時，自動朗讀單字" IsChecked="{Binding AutoSpeakWord}" Margin="0,8,0,14" />
                    <CheckBox Content="翻卡顯示答案後，自動朗讀英文例句" IsChecked="{Binding AutoSpeakExamples}" Margin="0,0,0,14" />
                    <TextBlock Text="各操作請選擇不同的按鍵。Space 是空白鍵，數字鍵同時支援鍵盤上排與數字鍵盤。" Style="{StaticResource MutedText}" FontSize="12" />
                    <UniformGrid Columns="5" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="翻卡" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding ShortcutKeys}" SelectedItem="{Binding FlipKey}" AutomationProperties.Name="翻卡快捷鍵" /></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="重來" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding ShortcutKeys}" SelectedItem="{Binding AgainKey}" AutomationProperties.Name="重來快捷鍵" /></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="困難" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding ShortcutKeys}" SelectedItem="{Binding HardKey}" AutomationProperties.Name="困難快捷鍵" /></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="良好" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding ShortcutKeys}" SelectedItem="{Binding GoodKey}" AutomationProperties.Name="良好快捷鍵" /></StackPanel>
                        <StackPanel><TextBlock Text="簡單" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding ShortcutKeys}" SelectedItem="{Binding EasyKey}" AutomationProperties.Name="簡單快捷鍵" /></StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,8,0,0" MaxWidth="420" HorizontalAlignment="Left">
                        <StackPanel Margin="0,0,16,0"><TextBlock Text="朗讀單字" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding ShortcutKeys}" SelectedItem="{Binding SpeakKey}" AutomationProperties.Name="朗讀單字快捷鍵" /></StackPanel>
                        <StackPanel><TextBlock Text="朗讀例句" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding ShortcutKeys}" SelectedItem="{Binding SpeakExampleKey}" AutomationProperties.Name="朗讀例句快捷鍵" /></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="本機 Codex 訂閱" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="使用官方 CLI 的既有 ChatGPT 登入。程式不要求 API key，也不會切換到付費 API。" Style="{StaticResource MutedText}" />
                    <TextBlock Text="Codex 執行檔路徑" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding CodexPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Codex 執行檔路徑" AutomationProperties.AutomationId="CodexPath" />
                    <WrapPanel Margin="0,8,0,0"><Button Content="自動尋找" Command="{Binding FindCodexCommand}" /><Button Content="選擇執行檔…" Command="{Binding BrowseCodexCommand}" /></WrapPanel>
                    <TextBlock Text="填入 codex 可在每次執行時自動尋找，支援 Codex 桌面版的版本目錄。也可以指定完整路徑。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" />
                    <TextBlock Text="生成模型" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ModelChoices}" DisplayMemberPath="Label" SelectedValuePath="Model"
                              SelectedValue="{Binding CodexModel, Mode=TwoWay}" AutomationProperties.Name="Codex 模型" AutomationProperties.AutomationId="CodexModelPicker" />
                    <TextBlock Text="{Binding ModelDescription}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="更新模型清單" Command="{Binding RefreshModelsCommand}" AutomationProperties.AutomationId="RefreshCodexModels" />
                        <Button Content="取消更新" Command="{Binding CancelModelRefreshCommand}" Visibility="{Binding RefreshModelsCommand.IsRunning, Converter={StaticResource BoolVisibility}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ModelStatus}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />
                    <TextBlock Text="生成速度" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding SpeedChoices}" DisplayMemberPath="Label" SelectedValuePath="Id"
                              SelectedValue="{Binding CodexServiceTier, Mode=TwoWay}" AutomationProperties.Name="Codex 生成速度" AutomationProperties.AutomationId="CodexSpeedPicker" />
                    <TextBlock Text="{Binding SpeedDescription}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" />
                    <TextBlock Text="加速選項與速度說明由所選模型提供。Fast 等加速模式會消耗較多訂閱額度；倍數是模型速度資訊，實際等待時間仍依內容而異。保存後套用到閱讀、聽力與詞義生成。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding DailyGenerationLimitHelp}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding DailyGenerationLimit, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" AutomationProperties.Name="每日 AI 生成上限" />
                    <WrapPanel Margin="0,20,0,0">
                        <Button Content="保存並檢查 Codex" Command="{Binding CheckAiCommand}" />
                    </WrapPanel>
                    <TextBlock Text="請在終端機使用 codex login 完成正常登入；本程式不讀取或顯示登入 token。訂閱額度或登入失效會顯示原因，離線學習不受影響。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="資料與備份" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="單字與複習進度存放於下方資料目錄的 wording.db。JSON 可交給 AI 編輯，再匯入更新；既有 ID 的複習進度會保留。" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                    <WrapPanel Margin="0,0,0,12"><Button Content="匯出單字 JSON" Command="{Binding ExportVocabularyCommand}" /><Button Content="匯入單字 JSON…" Command="{Binding ImportVocabularyCommand}" /></WrapPanel>
                    <TextBlock Text="備份包含單字、分類與複習進度。還原會替換整個單字庫，並先保存目前資料；不會合併兩份內容。" Style="{StaticResource MutedText}" />
                    <WrapPanel Margin="0,18,0,0">
                        <Button Content="匯出備份 ZIP" Command="{Binding BackupCommand}" AutomationProperties.AutomationId="CreateBackup" />
                        <Button Content="從備份還原…" Command="{Binding RestoreCommand}" AutomationProperties.AutomationId="RestoreBackup" />
                        <Button Content="開啟資料目錄" Command="{Binding OpenFolderCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,10,0,0" />
                    <TextBlock Text="建議另存一份到其他磁碟。換程式版本不會刪除這裡的資料。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Windows 英文合成語音" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding SpeechStatus}" Style="{StaticResource MutedText}" />
                    <TextBlock Text="使用電腦實際提供的英文 voice。若無可用語音，仍可從單字卡開啟外部辭典查閱發音。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
